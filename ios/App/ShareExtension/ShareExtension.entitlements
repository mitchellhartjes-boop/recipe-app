<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must be identical to the main app's App Group, or the extension writes
	     into a container the app cannot read and shares silently vanish. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mitchellhartjes.dilla</string>
	</array>
</dict>
</plist>
