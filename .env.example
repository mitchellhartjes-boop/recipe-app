# Supabase — the publishable key is safe to ship in the client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side only (used by the Netlify extract function — added in the next step).
# NEVER prefix this with VITE_, or it would leak into the client bundle.
# ANTHROPIC_API_KEY=sk-ant-xxx
